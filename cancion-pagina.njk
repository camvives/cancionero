---
pagination:
  data: canciones
  size: 1
  alias: cancion
permalink: "canciones/{{ cancion.slug }}/index.html"
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>{{ cancion.title }}</title>
  <link rel="stylesheet" href="{{ '/assets/estilos.css' | url }}">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&family=Fredoka:wght@600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <header class="header-cancion">
    <a href="{{ '/' | url }}" class="link-inicio">
        <span>volver a la lista</span>
    </a>
    </header>
    <h1>{{ cancion.title }}</h1>
  <p>Categoría: {{ cancion.category }}</p>
  <p>Tono actual: <span id="tono-actual">{{ cancion.key }}</span></p>

  <div class="controles">
    <button id="bajar">− Bajar tono</button>
    <button id="subir">+ Subir tono</button>
    <button id="copiar" class="boton-copiar">📋 Copiar</button>
  </div>

  <div id="cancion-render"></div>

  <script id="chordpro-fuente" type="text/plain">{{ cancion.chordpro }}</script>

    <script src="{{ '/assets/chordsheetjs.js' | url }}"></script>
    <script src="{{ '/assets/transponer.js' | url }}"></script>
</body>
</html>
