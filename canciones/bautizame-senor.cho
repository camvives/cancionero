{title: Bautízame Señor}
{key: Am}
{meta: category Espíritu-Santo}
{meta: sanpedro 84}
{meta: buenpastor 235}

{start_of_chorus}
[Am]Bautízame, Señor, con tu Espíritu,[E]
bautízame, Señor, con tu Espír[Am]itu (2)
{end_of_chorus}

{start_of_verse}
y déj[Dm]ame sentir
el fue[Am]go de tu amor
aquí[E] en mi corazón, Se[Am]ñor (2)
{end_of_verse}

{start_of_verse}
(Guíame, Señor...
Lléname, Señor...)
{end_of_verse}
