{title: Aleluya, Gloria, Aleluya}
{key: C}
{meta: category Aleluya}

{start_of_chorus}
[C]Aleluya, gloria Aleluya
[Am]Aleluya, gloria Aleluya
[F]Aleluya, gloria Aleluya
[G]Aleluya, gloria Aleluya
{end_of_chorus}

{start_of_verse}
[C]Cantad alegres, cantad a Dios
[Am]habitantes de toda la tierra
[F]Servid a Dios con alegría
[G]venid a Él con regocijo
{end_of_verse}

{start_of_chorus}
[C]Aleluya, gloria Aleluya
[Am]Aleluya, gloria Aleluya
[F]Aleluya, gloria Aleluya
[G]Aleluya, gloria Aleluya
{end_of_chorus}
