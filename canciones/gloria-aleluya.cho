{title: Gloria aleluya}
{key: C}
{meta: category Gloria}

{start_of_verse}
[C]Gloria, Gloria [Am]Aleluya
Gloria [F]Aleluya
Gloria a [G]Dios.
{end_of_verse}

{start_of_verse}
[C]Padre, Tú eres el [Am]Padre
único [F]Padre
el [G]Creador
{end_of_verse}

{start_of_verse}
[C]Hijo, Tú eres el [Am]Hijo
único [F]Hijo
el [G]Salvador
{end_of_verse}

{start_of_verse}
[C]Santo, Santo [Am]Espíritu
único [F]Espíritu
[G]Consolador
{end_of_verse}

{start_of_verse}
[C]A Ti, Trinidad [Am]Santa
sea la [F]gloria
sea el [G]honor.
{end_of_verse}
